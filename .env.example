# Hackathon only. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
PORT=3000

# Jira Cloud sandbox configuration for the manual-token fallback.
# OAuth connections use the Atlassian credentials below instead.
JIRA_CLOUD_ID=
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_ACCESS_TOKEN=

# Atlassian OAuth 2.0 3LO credentials from the Developer Console.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:3000/api/jira/callback

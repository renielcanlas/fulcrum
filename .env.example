# Jira Cloud sandbox target.
JIRA_CLOUD_ID=
JIRA_SITE_URL=https://your-site.atlassian.net

# Atlassian service-account OAuth 2.0 client credentials.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Separate Atlassian OAuth 2.0 (3LO) app for interactive user authorization/comments.
ATLASSIAN_USER_CLIENT_ID=
ATLASSIAN_USER_CLIENT_SECRET=
# Must exactly match the callback URL registered in the Atlassian OAuth 2.0 (3LO) app.
ATLASSIAN_REDIRECT_URI=https://your-domain.example/api/jira/callback

# Optional guided-demo-only Jira automation principal. Keep both values server-side;
# this token is used only for the synthetic Maya guided flow's comments/attachments.
JIRA_GUIDED_DEMO_EMAIL=wi9i7gurq@yzcalo.com
JIRA_GUIDED_DEMO_API_TOKEN=

# Azure AI Foundry model endpoint for the scenario assistant.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_VERSION=v1
AZURE_AI_FOUNDRY_FAST_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_KEY=

# Optional: use a published Microsoft Foundry hosted prompt agent as the
# primary language and knowledge runtime for Ciel and evaluations. The project endpoint must include
# /api/projects/<project-name>.
AZURE_AI_FOUNDRY_AGENT_ENABLED=false
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_FOUNDRY_AGENT_NAME=
AZURE_AI_FOUNDRY_AGENT_API_VERSION=v1
# Optional short-lived local token. Prefer DefaultAzureCredential in hosted environments.
AZURE_AI_FOUNDRY_AGENT_BEARER_TOKEN=
AZURE_AI_FOUNDRY_AGENT_SCOPE=https://ai.azure.com/.default
# DefaultAzureCredential service-principal values, if workload identity/managed identity is unavailable.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional OpenAI fallback when the hosted Foundry agent is unavailable,
# content-filtered, cannot return valid structured JSON, or cannot run local tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional Azure Application Insights destination for redacted AI execution spans.
# Keep this server-side; do not use a NEXT_PUBLIC_ prefix.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Neon/Vercel PostgreSQL. Prefer the pooled URL for request-time queries.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 32-byte hex or base64 key for encrypting persisted Jira OAuth tokens.
FULCRUM_DATA_ENCRYPTION_KEY=

# Synthetic demo login. Prefer a precomputed scrypt value in hosted environments.
FULCRUM_DEMO_PASSWORD_HASH=
FULCRUM_DEMO_PASSWORD=

# Azure AI Document Intelligence for Jira attachment extraction.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-document-intelligence-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
